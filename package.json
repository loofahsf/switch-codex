{
  "name": "switch-codex",
  "version": "2.0.1",
  "description": "A macOS-first Wails app for switching Codex auth.json profiles.",
  "author": "Switch Codex",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/desktop.mjs dev",
    "build": "node scripts/desktop.mjs package",
    "dev:web": "vite --host 127.0.0.1 --port 1420",
    "build:web": "tsc --noEmit && vite build",
    "build:mac:arm": "node scripts/desktop.mjs package darwin arm64",
    "build:mac:x64": "node scripts/desktop.mjs package darwin amd64",
    "build:win:x64": "node scripts/desktop.mjs package windows amd64",
    "lint": "npm run version:check && tsc --noEmit",
    "version:check": "node scripts/check-release-version.mjs",
    "desktop:setup": "node scripts/desktop.mjs setup",
    "bindings": "node scripts/desktop.mjs bindings",
    "bindings:check": "node scripts/desktop.mjs check-bindings",
    "version:sync": "node scripts/sync-version.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@ant-design/plots": "2.6.8",
    "antd": "6.5.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "dayjs": "1.11.22",
    "@wailsio/runtime": "3.0.0-beta.18"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.4",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.0"
  }
}