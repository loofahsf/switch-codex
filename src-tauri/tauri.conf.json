{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Switch Codex",
  "version": "1.1.0",
  "identifier": "com.switchcodex.app",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Switch Codex",
        "url": "index.html",
        "width": 960,
        "height": 640,
        "minWidth": 780,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 16
        },
        "backgroundColor": "#f4f4f5"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 Switch Codex",
    "category": "Utility",
    "macOS": {
      "minimumSystemVersion": "10.13"
    }
  }
}
