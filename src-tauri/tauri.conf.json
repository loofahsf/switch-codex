{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Switch Codex",
  "version": "0.0.0",
  "identifier": "com.switchcodex.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Switch Codex",
        "url": "index.html",
        "width": 980,
        "height": 680,
        "minWidth": 780,
        "minHeight": 560,
        "backgroundColor": "#f6f5f1"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 Switch Codex",
    "category": "Utility",
    "macOS": {
      "minimumSystemVersion": "10.13"
    }
  }
}
